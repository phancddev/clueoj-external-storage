# ClueOJ External Storage — environment variables
# Copy to .env and fill in. NEVER commit .env with real secrets.

# --- Problem root (host path mounted into storage-rust) ---
STORAGE_PROBLEM_ROOT_HOST=../clueoj/problems
STORAGE_PROBLEM_ROOT_CONTAINER=/problems
STORAGE_PROBLEM_ROOT=/problems
# Set these to the numeric owner of STORAGE_PROBLEM_ROOT_HOST.
# Example: STORAGE_RUST_UID=$(id -u), STORAGE_RUST_GID=$(id -g)
STORAGE_RUST_UID=
STORAGE_RUST_GID=
STORAGE_RUST_CHECK_PROBLEM_ROOT_WRITE=true

# --- Web / dashboard ---
STORAGE_PORT=2907
# Bind to loopback by default. On Linux host-gateway deployments, set this to
# the Docker host-gateway address (commonly 172.17.0.1), not 0.0.0.0.
STORAGE_PUBLISH_HOST=127.0.0.1
STORAGE_PUBLIC_BASE_URL=http://localhost:2907

# --- Storage app PostgreSQL (independent from ClueOJ MariaDB) ---
STORAGE_DATABASE_URL=postgresql://storage:replace-with-strong-password@storage-db:5432/storage
POSTGRES_USER=storage
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=storage

# --- ClueOJ service auth ---
STORAGE_CLUEOJ_SERVICE_AUDIENCE=clueoj-storage
STORAGE_CLUEOJ_SERVICE_SECRET=
STORAGE_JWT_SECRET=
STORAGE_DASHBOARD_JWT_SECRET=
STORAGE_DASHBOARD_JWT_AUDIENCE=clueoj-storage-dashboard
# Canonical Rust/control-plane internal token. Compose maps this to
# STORAGE_RUST_INTERNAL_TOKEN inside storage-web; do not define both.
STORAGE_INTERNAL_SERVICE_TOKEN=

# --- ClueOJ integration client ---
# Copy only this client/auth subset into the ClueOJ site, Celery worker, and
# Celery beat runtime. Do not expose the PostgreSQL, R2, or internal Rust
# credentials to ClueOJ. The hostname below requires a shared Docker network;
# use http://host.docker.internal:2907/api/v1 when following the host-gateway
# deployment documented in docs/clueoj-integration.md.
STORAGE_SERVICE_BASE_URL=http://storage-web:2907/api/v1
# Legacy static bearer token fallback only. Normal ClueOJ compose mints service
# JWTs from STORAGE_CLUEOJ_SERVICE_SECRET, so leave this empty.
STORAGE_SERVICE_TOKEN=
STORAGE_SERVICE_ISSUER=clueoj-storage
STORAGE_SERVICE_AUDIENCE=clueoj-storage
STORAGE_SERVICE_SUBJECT=clueoj
STORAGE_SERVICE_SCOPES=read,mutate,downloads:issue
STORAGE_SERVICE_TOKEN_TTL_SECONDS=300
STORAGE_SERVICE_TOKEN_SKEW_SECONDS=30
STORAGE_SERVICE_TIMEOUT=10
STORAGE_ENSURE_READY_MAX_ATTEMPTS=12
STORAGE_ENSURE_READY_RETRY_BASE_SECONDS=5
STORAGE_ENSURE_READY_RETRY_MAX_SECONDS=60

# --- Dashboard auth ---
# Dashboard administrators live in PostgreSQL. After migrations, create one with:
# ./scripts/storage-admin create <username>
STORAGE_CORS_ALLOWED_ORIGINS=http://localhost:2907,http://127.0.0.1:2907
STORAGE_TRUST_PROXY=false
STORAGE_WORKER_ENABLED=true
# Parallel job loops. Snapshots/evicts/backfill share these slots.
STORAGE_WORKER_CONCURRENCY=8
# Worker slots reserved for restore jobs only, so a submission-triggered
# restore never queues behind snapshot/backfill bulk work. Clamped to
# STORAGE_WORKER_CONCURRENCY; 0 disables the dedicated lane.
STORAGE_RESTORE_RESERVED_CONCURRENCY=2
STORAGE_WORKER_LEASE_SECONDS=60

# --- Object store ---
# Production default: R2 auto-push. For local smoke/dev only, override both:
# STORAGE_ALLOW_INSECURE_DEV=true and STORAGE_OBJECT_STORE=inmemory.
STORAGE_ALLOW_INSECURE_DEV=false
STORAGE_OBJECT_STORE=r2

# --- R2 / S3 compatible (required when STORAGE_OBJECT_STORE=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clueoj-problems
R2_ENDPOINT=
R2_REGION=auto
# Presigned URL TTL in seconds (default 180, max 300)
R2_PRESIGN_TTL_SECONDS=180

# --- Feature flags (all default OFF for safe rollout) ---
STORAGE_PLATFORM_ENABLED=false
STORAGE_DIRECT_DOWNLOAD_ENABLED=false
STORAGE_CATALOG_SYNC_ENABLED=false
STORAGE_ATOMIC_WRITES_ENABLED=false
STORAGE_ENSURE_READY_ENABLED=false

# --- Eviction (default OFF) ---
STORAGE_EVICTION_ENABLED=false
# ClueOJ Celery performs a passive, indexed sweep. Enable both flags only
# after migrations and ensure-ready restore have been verified in production.
STORAGE_LOCAL_EVICTION_ENABLED=false
STORAGE_LOCAL_EVICTION_IDLE_HOURS=24
STORAGE_LOCAL_EVICTION_BATCH_SIZE=50
STORAGE_LOCAL_EVICTION_SWEEP_SECONDS=3600

# --- Retention ---
STORAGE_JOB_RETENTION_DAYS=90
STORAGE_AUDIT_RETENTION_DAYS=365
STORAGE_SUPERSEDED_SNAPSHOT_RETENTION_DAYS=30
STORAGE_CONTENT_GC_SAFETY_WINDOW_DAYS=7

# --- Logging ---
STORAGE_LOG_LEVEL=info
RUST_LOG=info
